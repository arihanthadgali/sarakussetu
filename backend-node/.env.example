# Runtime environment: development, test, or production.
NODE_ENV=development
PORT=3000

# Comma-separated browser origins. Leave empty while no browser-facing API routes exist.
CORS_ORIGIN=

# Flyway-managed PostgreSQL database (db/postgresql/migration). Do not use Prisma migration or db push commands.
# URL-encode reserved characters in the username or password.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?schema=public

# Base64-encoded HMAC-SHA256 key (minimum 32 decoded bytes) for OTP verification tokens.
JWT_SECRET=BASE64_ENCODED_32_BYTE_SECRET
JWT_ACCESS_TOKEN_TTL=PT1H

# Optional Razorpay credentials. Payment routes report the service as unavailable
# until these values are configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
