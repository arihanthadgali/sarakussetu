# Runtime environment: development, test, or production.
NODE_ENV=development
PORT=3000

# Comma-separated browser origins. Leave empty while no browser-facing API routes exist.
CORS_ORIGIN=

# Existing Flyway-managed MySQL database. Do not use Prisma migration or db push commands.
# URL-encode reserved characters in the username or password.
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME
