# Base URL of the existing SarakuSetu Node backend (backend-node, default port 3000).
# Expo inlines EXPO_PUBLIC_* variables at bundle time; never put secrets here.
#
# Android emulator  -> http://10.0.2.2:3000   (default when unset)
# Physical device   -> http://<your-computer-LAN-IP>:3000
# iOS simulator     -> http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=http://YOUR-LAN-IP:3000
